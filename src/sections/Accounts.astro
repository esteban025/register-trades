---
import { PlusIcon } from "@/assets/icons/icons";
import { CardsAccounts } from "@/components/CardsAccounts";
---

<section class="flex flex-col gap-8">
  <header class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold">Cuentas</h2>
    <div class="flex items-center gap-2">
      <button class="btn btn-secondary btn-actives">
        <PlusIcon />
        <span>Activos</span>
      </button>
      <button class="btn btn-primary btn-accounts">
        <PlusIcon />
        <span>Cuenta</span>
      </button>
    </div>
  </header>
  <CardsAccounts client:load />
</section>

<script>
  import { isModalAccountOpen, isModalInstrumentOpen } from "@/store";
  import { $ } from "@/utils/getElementsDom";

  document.addEventListener("astro:page-load", () => {
    const btnOpenModal = $(".btn-accounts") as HTMLButtonElement;
    const btnOpenModalActives = $(".btn-actives") as HTMLButtonElement;

    btnOpenModal?.addEventListener("click", () => {
      isModalAccountOpen.set(true);
    });

    btnOpenModalActives?.addEventListener("click", () => {
      isModalInstrumentOpen.set(true);
    });
  });
</script>
