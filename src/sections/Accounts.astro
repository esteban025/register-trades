---
import { PlusIcon } from "@/assets/icons/icons";
import { CardsAccounts } from "@/components/CardsAccounts";
---

<section class="flex flex-col gap-8">
  <header class="flex items-center justify-between">
    <h2 class="text-2xl font-semibold">Cuentas</h2>
    <button class="btn btn-primary btn-accounts">
      <PlusIcon />
      <span>Cuenta</span>
    </button>
  </header>
  <CardsAccounts client:load />
</section>

<script>
  import { isModalAccountOpen } from "@/store";

  document.addEventListener("DOMContentLoaded", () => {
    const btnOpenModal = document.querySelector(".btn-accounts");

    btnOpenModal?.addEventListener("click", () => {
      isModalAccountOpen.set(true);
    });
  });
</script>
