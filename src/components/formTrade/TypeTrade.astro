<div class="">
  <ul
    class="flex items-center bg-neutral-800 rounded-full border border-neutral-700 relative"
  >
    <li class="relative w-full flex items-center justify-center z-20">
      <input
        class="absolute inset-0 w-full h-full cursor-pointer opacity-0 type-trade"
        type="radio"
        name="type"
        id="type-buy"
        value="compra"
        checked
      />
      <label for="type-buy" class="w-full p-2 text-center">Compra</label>
    </li>
    <li class="relative w-full flex items-center justify-center z-20">
      <input
        type="radio"
        name="type"
        id="type-sell"
        value="venta"
        class="absolute inset-0 w-full h-full cursor-pointer opacity-0 type-trade"
      />
      <label for="type-sell" class="w-full p-2 text-center">Venta</label>
    </li>
    <li
      id="indicator-type"
      class="absolute w-1/2 h-full left-0 rounded-full transition-transform duration-300"
      style="background: var(--color-primary);"
    >
    </li>
  </ul>
</div>

<script>
  import { $$, $id } from "@/utils/getElementsDom";

  document.addEventListener("astro:page-load", () => {
    function updateIndicator() {
      const typesInputs = $$(".type-trade") as NodeListOf<HTMLInputElement>;
      const indicator = $id("indicator-type");

      if (!typesInputs || !indicator) return;
      const inputsTypes = Array.from(typesInputs);
      const activeIndex = inputsTypes.findIndex((input) => input.checked);

      if (activeIndex !== -1) {
        indicator.style.transform = `translateX(${activeIndex * 100}%)`;
      }
    }

    const typesInputs = $$(".type-trade") as NodeListOf<HTMLInputElement>;
    typesInputs.forEach((input) => {
      input.addEventListener("change", () => {
        updateIndicator();
      });
    });

    (window as any).updateIndicator = updateIndicator;
    updateIndicator();
  });
</script>
